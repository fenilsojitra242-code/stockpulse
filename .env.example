# StockPulse Environment Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Email OTP Verification (Brevo - Recommended for Render & Cloud Hosts)
# ---------------------------------------------------------------------------
# Brevo sends transactional emails over Port 443 HTTPS (never blocked by cloud firewalls).
# Get your free API key at https://app.brevo.com/settings/keys/api
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# ---------------------------------------------------------------------------
# Alternative: Resend HTTP API (Port 443 HTTPS)
# ---------------------------------------------------------------------------
# RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Alternative: Standard SMTP (Gmail, Hostinger, AWS SES, cPanel)
# ---------------------------------------------------------------------------
# Note: Render Free Tier blocks outbound SMTP port 587. Use Brevo or Resend for Render.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=StockPulse Security
# SMTP_TLS=true
