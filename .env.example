HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------
# Local Development: Automatically defaults to SQLite at data/stockpulse.db if unset.
# DATABASE_URL=sqlite:///data/stockpulse.db
#
# Production on Render Free (Neon Managed PostgreSQL Free):
# Use Neon's pooled connection string for optimal connection handling.
# Example: postgresql://username:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Security / Token Signing Keys
JWT_SECRET_KEY=
SECRET_KEY=

# ---------------------------------------------------------------------------
# Email OTP Verification (Brevo - Recommended for Render & Cloud Hosts)
# ---------------------------------------------------------------------------
# Brevo sends transactional emails over Port 443 HTTPS (never blocked by cloud firewalls).
# Get your free API key at https://app.brevo.com/settings/keys/api
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# ---------------------------------------------------------------------------
# Alternative: Resend HTTP API (Port 443 HTTPS)
# ---------------------------------------------------------------------------
# RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Alternative: Standard SMTP (Gmail, Hostinger, AWS SES, cPanel)
# ---------------------------------------------------------------------------
# Note: Render Free Tier blocks outbound SMTP port 587. Use Brevo or Resend for Render.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=StockPulse Security
# SMTP_TLS=true
