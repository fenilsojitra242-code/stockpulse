# StockPulse Environment Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Email OTP Verification (SMTP Configuration)
# ---------------------------------------------------------------------------
# To send real verification codes directly to user Gmail / email inboxes,
# enter your SMTP credentials below.
#
# For Gmail:
# 1. Go to your Google Account -> Security -> 2-Step Verification
# 2. At the bottom, click "App passwords"
# 3. Create an app password named "StockPulse"
# 4. Paste your 16-character password into SMTP_PASSWORD below
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=StockPulse Security
SMTP_TLS=true
